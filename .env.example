# Compose dev environment — safe defaults, no production secrets (rules §11).
# Ports are configurable (§8.1); change here, never in docker-compose.yml.

API_PORT=8080
POSTGRES_PORT=5544
POSTGRES_USER=underground
POSTGRES_PASSWORD=underground_dev_pw
POSTGRES_DB=underground_dev
RUST_LOG=info
JWT_SECRET=dev-insecure-secret-change-me
