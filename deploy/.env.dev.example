# Underground DEV deployment config. Copy to deploy/.env.dev ON THE SERVER and fill in
# JWT_SECRET with a freshly minted value (never commit a real secret — rules §11).

# Where the stack's persistent data lives on the host (pg data + uploaded posters).
DATA_DIR=/opt/underground-dev/data

# Public URLs, as a browser sees them. Web and API share one origin so the browser makes
# same-origin calls (Caddy routes /api,/uploads,/health to the API) — no CORS at all.
PUBLIC_WEB_URL=https://underground.159-69-159-230.sslip.io
PUBLIC_API_URL=https://underground.159-69-159-230.sslip.io
PUBLIC_ADMIN_API_URL=https://underground-admin.159-69-159-230.sslip.io
CORS_ALLOWED_ORIGINS=https://underground.159-69-159-230.sslip.io,https://underground-admin.159-69-159-230.sslip.io

ENVIRONMENT=development
RUST_LOG=info,underground_api=debug

POSTGRES_USER=underground
POSTGRES_DB=underground_dev
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
