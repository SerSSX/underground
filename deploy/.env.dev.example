# Underground DEV config. deploy/bootstrap-dev.sh copies it to /opt/underground-dev/.env.dev ON THE BOX and
# replaces every CHANGE_ME with a freshly generated hex value there. Values never leave the box and are
# never committed or printed (rules §9). Hex only: compose expands `$` inside env files.

DATA_DIR=/opt/underground-dev/data

# Public URLs as a browser sees them. Web and API share one origin (Caddy routes /api, /uploads, /health).
PUBLIC_WEB_URL=https://underground-dev.65-108-87-247.sslip.io
PUBLIC_ADMIN_URL=https://underground-admin-dev.65-108-87-247.sslip.io
CORS_ALLOWED_ORIGINS=https://underground-dev.65-108-87-247.sslip.io,https://underground-admin-dev.65-108-87-247.sslip.io

ENVIRONMENT=development
RUST_LOG=info,underground_api=debug

POSTGRES_USER=underground
POSTGRES_DB=underground_dev
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
# Password of the standing demo accounts user@, maker@, admin@underground.dev (and, by hash copy, of every
# seeded demo profile). Read it on the box only: deploy/show-dev-login.sh prints it in the owner's terminal.
UG_SEED_PASSWORD=CHANGE_ME
