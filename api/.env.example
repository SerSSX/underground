# Underground API — local (non-container) run config. Copy to api/.env for `cargo run`.
# For the full container stack use the repo-root .env + docker compose instead.

DATABASE_URL=postgres://underground:underground_dev_pw@localhost:5544/underground_dev
PORT=8080
RUST_LOG=info

# Optional limits (defaults shown; docs/configuration-manual.md lists them all).
# TELEMETRY_LIMIT_PER_IP=120
# TELEMETRY_DAILY_MAX=40000
# TELEMETRY_DAILY_ANON=20000
# TELEMETRY_RETENTION_DAYS=30
